+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef SPRD_DPU_CONSOLE_H
+#define SPRD_DPU_CONSOLE_H
+
+#include <mach/mach_types.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef int32_t (*sprd_dpu_spi_register_t)(uint32_t, bool, void (*)(void *), void *, uint32_t *, uint64_t *);
+
+#if defined(XNU_SPRD_DPU_CONSOLE) && XNU_SPRD_DPU_CONSOLE
+void sprd_dpu_console_bind(vm_offset_t, uint64_t, uint32_t, uint32_t, uint32_t, uint32_t);
+void sprd_dpu_console_flush(bool);
+bool sprd_dpu_console_start_interrupts(sprd_dpu_spi_register_t);
+#else
+#define sprd_dpu_console_bind(...) ((void)0)
+#define sprd_dpu_console_flush(...) ((void)0)
+#endif
+
+#endif
