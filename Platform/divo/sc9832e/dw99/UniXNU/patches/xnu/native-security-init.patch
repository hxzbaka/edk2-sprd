         isSecurityKext = OSDynamicCast(OSBoolean,
             theKext->getPropertyForHostArch(kAppleSecurityExtensionKey));
         if (isSecurityKext && isSecurityKext->isTrue()) {
+            if (theKext->getPropertyForHostArch("_NativePrelinkEarlySecurityInit")) {
+                OSDictionary *matching = IOService::serviceMatching("IOPlatformExpert");
+                if (!matching || !IOService::waitForService(matching)) {
+                    panic("NativePrelink: platform expert unavailable for security initialization");
+                }
+            }
             OSKextLog(/* kext */ NULL,
                 kOSKextLogStepLevel |
                 kOSKextLogLoadFlag,
