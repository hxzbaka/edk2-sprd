index 0000000..3240fbf
--- /dev/null
+++ b/DarwinBootPkg/DarwinBootPkg.dec
@@ -0,0 +1,27 @@
+## @file
+#  SPDX-License-Identifier: BSD-2-Clause-Patent
+##
+
+[Defines]
+  DEC_SPECIFICATION = 0x00010019
+  PACKAGE_NAME = DarwinBootPkg
+  PACKAGE_GUID = 719BDCCD-BD34-48F7-A97C-8DD629D078A4
+  PACKAGE_VERSION = 0.1
+
+[Includes]
+  Include
+
+[LibraryClasses]
+  DarwinBootHandoffLib|Include/Library/DarwinBootHandoffLib.h
+
+[Guids]
+  gDarwinBootPkgTokenSpaceGuid = { 0x378ea2de, 0x232e, 0x46ed, { 0xae, 0x0d, 0x49, 0x51, 0x22, 0xbc, 0x80, 0x40 } }
+
+[PcdsFixedAtBuild]
+  gDarwinBootPkgTokenSpaceGuid.PcdDarwinBootDefaultWindowSize|0x10000000|UINT64|0x00000001
+  gDarwinBootPkgTokenSpaceGuid.PcdDarwinBootMaxKernelSize|0x10000000|UINT64|0x00000002
+  gDarwinBootPkgTokenSpaceGuid.PcdDarwinBootMinWindowSize|0x10000000|UINT64|0x00000003
+  gDarwinBootPkgTokenSpaceGuid.PcdDarwinBootMaxWindowSize|0x200000000|UINT64|0x00000004
+  gDarwinBootPkgTokenSpaceGuid.PcdDarwinBootVisualDiagnostics|TRUE|BOOLEAN|0x00000005
+  gDarwinBootPkgTokenSpaceGuid.PcdDarwinBootCommandLineSize|1024|UINT32|0x00000006
+  gDarwinBootPkgTokenSpaceGuid.PcdDarwinBootHandoffTimeoutUs|500000|UINT32|0x00000007
