+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef DARWIN_BOOT_HANDOFF_LIB_H_
+#define DARWIN_BOOT_HANDOFF_LIB_H_
+
+#include <Base.h>
+
+/**
+  Commit a BGRA progress marker after ExitBootServices.
+
+  Implementations must follow AAPCS64 without accessing the stack, using
+  floating point, or calling firmware services. Code and resources must be
+  identity mapped so that the same entry works with the MMU enabled or disabled.
+  TRUE means the transfer completed and its completion state is retained for
+  the next framebuffer owner. FALSE prevents further handoff.
+**/
+BOOLEAN
+EFIAPI
+DarwinBootMarkStage (
+  IN UINT64  FrameBuffer,
+  IN UINT64  FrameBufferBytes,
+  IN UINT32  Color
+  );
+
+#endif
